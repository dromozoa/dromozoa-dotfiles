truecolor on
shell -$SHELL
startup_message off
cjkwidth on
maptimeout 0
msgminwait 0

defutf8
defencoding UTF-8

# v5で色の文字指定が廃止された。両対応のために両方指定する。
# | 4 | 5 | color   |
# |---|---|---------|
# | k | 0 | black   |
# | r | 1 | red     |
# | g | 2 | green   |
# | y | 3 | yellow  |
# | b | 4 | blue    |
# | m | 5 | magenta |
# | c | 6 | cyan    |
# | w | 7 | white   |
setenv s ""
setenv s "$s%{= wk}%{= 0;7}"  # 左側ウィンドウリストの色: 前景黒/背景白
setenv s "$s%-w"              # 左側ウィンドウリスト（フラグなし）
setenv s "$s%{= yk}%{= 0;3}"  # 現在ウィンドウの色: 前景黒/背景黄色
setenv s "$s%50>"             # 真ん中寄せ
setenv s "$s%n %t"            # 現在ウィンドウの番号とタイトル
setenv s "$s%{= wk}%{= 0;7}"  # 右側ウィンドウリストの色: 前景黒/背景白
setenv s "$s%+w"              # 右側ウィンドウリスト（フラグなし）
setenv s "$s%<"               # 切り詰め
hardstatus alwayslastline "$s"
unsetenv s

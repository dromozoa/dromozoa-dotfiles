package.path = os.getenv "HOME" .. "/dromozoa-dotfiles/?.lua;" .. package.path

local encode_base64 = require "dromozoa.encode_base64"

local inside_gnu_screen = (os.getenv "INSIDE_GNU_SCREEN" or "") ~= ""

local filename = ...

local data
if filename then
  local handle = assert(io.open(filename, "rb"))
  data = handle:read "*a"
  handle:close()
else
  data = io.read "*a"
end

local payload = "\27]52;;" .. encode_base64(data) .. "\7"

if inside_gnu_screen then
  for i = 1, #payload, 512 do
    io.write("\27P", payload:sub(i, i + 511), "\27\\")
  end
else
  io.write(payload)
end

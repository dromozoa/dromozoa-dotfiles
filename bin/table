local help = ([[
Usage: %s [options] command
Avairable options are:
  -m  --multiple-lines
  -t  --transpose
  -h  --help
Avairable commands are:
  csv_to_csv
  csv_to_tsv
  csv_to_md
  tsv_to_tsv
  tsv_to_csv
  tsv_to_md
]]):format(arg[0])

local multiple_lines = false
local transpose = false

local i = 1
while i <= #arg do
  local opt = arg[i]
  i = i + 1
  if opt == "-m" or opt == "--multiple-lines" then
    multiple_lines = true
  elseif opt == "-t" or opt == "--transpose" then
    transpose = true
  elseif opt == "-h" or opt == "--help" then
    io.stderr:write(help)
    os.exit()
  elseif opt == "--" then
    break
  else
    i = i - 1
    break
  end
end

local command = assert(arg[i])

---@param source string
---@return string[][]
local function parse_csv(source)
  local position = 1
  local text

  local function match(pattern)
    local i, j = source:find("^" .. pattern, position)
    if i then
      position = j + 1
      text = source:sub(i, j)
      return true
    else
      text = nil
      return false
    end
  end

  local records = {}
  local fields = {}
  local state = 1

  local function push(kind, value)
    if state == 1 then
      if kind == "Field" then
        table.insert(fields, value)
        state = 2
      elseif kind == "Comma" then
        table.insert(fields, "")
      elseif kind == "LineBreak" then
        table.insert(fields, "")
        table.insert(records, fields)
        fields = {}
        state = 3
      elseif kind == "EOF" then
        table.insert(fields, "")
        table.insert(records, fields)
        fields = nil
        state = 4
      end
    elseif state == 2 then
      if kind == "Field" then
        error("unexpected token <Field> at record " .. (#records + 1))
      elseif kind == "Comma" then
        state = 1
      elseif kind == "LineBreak" then
        table.insert(records, fields)
        fields = {}
        state = 3
      elseif kind == "EOF" then
        table.insert(records, fields)
        fields = nil
        state = 4
      end
    else
      assert(state == 3)
      if kind == "Field" then
        table.insert(fields, value)
        state = 2
      elseif kind == "Comma" then
        table.insert(fields, "")
        state = 1
      elseif kind == "LineBreak" then
        table.insert(fields, "")
        table.insert(records, fields)
        fields = {}
      elseif kind == "EOF" then
        assert(#fields == 0)
        fields = nil
        state = 4
      end
    end
  end

  while position <= #source do
    if match "\n" then
      push "LineBreak"
    elseif match "," then
      push "Comma"
    elseif match '"' then
      local value = {}
      while true do
        if match '[^"]+' then
          table.insert(value, text)
        elseif match '""' then
          table.insert(value, '"')
        elseif match '"' then
          break
        else
          error("unfinished field at position " .. position)
        end
      end
      push("Field", table.concat(value))
    else
      assert(match '[^\n,"]+')
      push("Field", text)
    end
  end
  push "EOF"

  assert(state == 4)
  return records
end

---@param source string
---@return string[][]
local function parse_tsv(source)
  local records = {}
  for line in source:gmatch "([^\n]*)\n?" do
    local fields = {}
    for field in (line.."\t"):gmatch "(.-)\t" do
      table.insert(fields, field)
    end
    table.insert(records, fields)
  end
  return records
end

---@param source_records string[][]
---@return string[][]
local function process_records(source_records)
  local m = #source_records
  local n = 0
  for _, fields in ipairs(source_records) do
    n = math.max(n, #fields)
  end

  local result_records = {}
  if transpose then
    for i = 1, n do
      result_records[i] = {}
      for j = 1, m do
        result_records[i][j] = source_records[j][i] or ""
      end
    end
  else
    for i = 1, m do
      result_records[i] = {}
      for j = 1, n do
        result_records[i][j] = source_records[i][j] or ""
      end
    end
  end

  return result_records
end

---@param field string
---@return string
local function process_multiple_lines(field)
  if multiple_lines then
    return field
  else
    return (field:gsub("\n.*", ""))
  end
end

---@param field string
---@return string
local function quote_csv(field)
  field = process_multiple_lines(field)
  if field:find '[\n\",]' then
    return '"' .. field:gsub('"', '""') .. '"'
  else
    return field
  end
end

---@param field string
---@return string
local function quote_tsv(field)
  field = process_multiple_lines(field)
  -- \t => U+21E5 RIGHTWARDS ARROW TO BAR
  -- \n => U+21B5 DOWNWARDS ARROW WITH CORNER LEFTWARDS
  return (field:gsub("\t", "\226\135\165"):gsub("\n", "\226\134\181"))
end

---@param field string
---@return string
local function quote_markdown(field)
  field = process_multiple_lines(field)
  return (field:gsub("\n", "<br>"):gsub("|", "\\|"))
end

---@param records string[][]
---@param quote fun(field: string):string
---@param separator string
local function write(records, quote, separator)
  for _, fields in ipairs(records) do
    local buffer = {}
    for i, field in ipairs(fields) do
      buffer[i] = quote(field)
    end
    io.write(table.concat(buffer, separator), "\n")
  end
end

---@param records string[][]
local function write_markdown(records)
  for i, fields in ipairs(records) do
    for _, field in ipairs(fields) do
      io.write("|", quote_markdown(field))
    end
    io.write "|\n"

    if i == 1 then
      for _ = 1, #fields do
        io.write "|---"
      end
      io.write "|\n"
    end
  end
end

local commands = {}

---@param source string
function commands.csv_to_csv(source)
  write(process_records(parse_csv(source)), quote_csv, ",")
end

---@param source string
function commands.csv_to_tsv(source)
  write(process_records(parse_csv(source)), quote_tsv, "\t")
end

---@param source string
function commands.csv_to_md(source)
  write_markdown(process_records(parse_csv(source)))
end

---@param source string
function commands.tsv_to_tsv(source)
  write(process_records(parse_tsv(source)), quote_tsv, "\t")
end

---@param source string
function commands.tsv_to_csv(source)
  write(process_records(parse_tsv(source)), quote_csv, ",")
end

---@param source string
function commands.tsv_to_md(source)
  write_markdown(process_records(parse_tsv(source)))
end

local command_fn = assert(commands[command])
command_fn(io.read "*a":gsub("\n\r", "\n"):gsub("\r\n?", "\n"))

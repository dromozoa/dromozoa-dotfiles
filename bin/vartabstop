-- タブ区切りテキストを読んでvartabstopを計算する

local filename = ...

local padding = 2
local vartabstop = {}

for line in io.lines(filename) do
  local i = 0
  for cell in line:gmatch "([^\t\r]*)[\t\r]?" do
    i = i + 1
    vartabstop[i] = math.max(vartabstop[i] or padding, #cell + padding)
  end
end

io.write("setlocal vartabstop=", table.concat(vartabstop, ","), "\n")

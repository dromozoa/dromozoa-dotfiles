if test -z "$XDG_STATE_HOME"
then
  XDG_STATE_HOME=$HOME/.local/state
fi
export XDG_STATE_HOME
mkdir -p "$XDG_STATE_HOME"

log=$XDG_STATE_HOME/zsphre.log

lua=
for i in luajit lua
do
  if "$i" -v >/dev/null 2>&1
  then
    lua=$i
    break
  fi
done

if test -z "$lua"
then
  echo "command not found: lua" >>"$log"
  exit
fi

if ! sqlite3 -version >/dev/null 2>&1
then
  echo "command not found: sqlite3" >>"$log"
  exit
fi

"$lua" "$0.lua" "$@" >>"$log" 2>&1 || :

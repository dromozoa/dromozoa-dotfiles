if test -z "$XDG_STATE_HOME"
then
  XDG_STATE_HOME=$HOME/.local/state
fi
export XDG_STATE_HOME
mkdir -p "$XDG_STATE_HOME"

lua=
for i in luajit lua
do
  if "$i" -v >/dev/null 2>&1
  then
    lua=$i
    break
  fi
done

case X$1 in
  Xzsh_hook_*)
    log=$XDG_STATE_HOME/zsphre.log
    if test -z "$lua"
    then
      echo "command not found: lua" >>"$log"
      exit
    fi
    if test "$1" = zsh_hook_preexec
    then
      "$lua" "$0.lua" "$@" 2>>"$log" || :
    else
      "$lua" "$0.lua" "$@" >>"$log" 2>&1 || :
    fi
    ;;
  *)
    if test -z "$lua"
    then
      echo "command not found: lua" >&2
      exit 1
    fi
    exec "$lua" "$0.lua" "$@"
    ;;
esac

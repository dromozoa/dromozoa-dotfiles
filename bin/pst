#! /usr/bin/env lua

local keywords = {
  "user",
  "pid",
  "ppid",
  "pgid",
  "pcpu",
  "pmem",
  "rss",
  "command",
}

local cols
do
  local handle = assert(io.popen "tput cols")
  local text = handle:read "*a"
  handle:close()
  ---@type integer
  cols = assert(tonumber(assert(text:gsub("\n+$", ""):match "^%d+$")))
end

local sort
local threshold

---@class dromozoa.dotfiles.pst.process
---@field user string
---@field pid integer
---@field ppid integer
---@field pgid integer
---@field pcpu number
---@field pmem number
---@field rss integer
---@field command string
---@field parent_process? dromozoa.dotfiles.pst.process
---@field child_processes dromozoa.dotfiles.pst.process[]
---@field subtree_pcpu number
---@field subtree_pmem number
---@field subtree_rss integer
local class = {}
local metatable = {
  __index = class,
  __name = "dromozoa.dotfiles.pst.process",
}

---@param items string[]
---@return dromozoa.dotfiles.pst.process
function class.new(items)
  ---@type table<string, string>
  local that = {}
  for i, keyword in ipairs(keywords) do
    that[keyword] = items[i]
  end
  return setmetatable({
    user = that.user,
    pid = tonumber(assert(that.pid:match "^%d+$")),
    ppid = tonumber(assert(that.ppid:match "^%d+$")),
    pgid = tonumber(assert(that.pgid:match "^%d+$")),
    pcpu = tonumber(assert(that.pcpu:match "^(%d+%.%d+)$")),
    pmem = tonumber(assert(that.pmem:match "^(%d+%.%d+)$")),
    rss = tonumber(assert(that.rss:match "^%d+$")),
    command = that.command,
    parent_process = nil,
    child_processes = {},
    subtree_pcpu = 0.0,
    subtree_pmem = 0.0,
    subtree_rss = 0,
  }, metatable)
end

function class:compute_subtree()
  self.subtree_pcpu = self.pcpu
  self.subtree_pmem = self.pmem
  self.subtree_rss = self.rss

  for _, child_process in ipairs(self.child_processes) do
    child_process:compute_subtree()
  end

  table.sort(self.child_processes, sort)

  local parent_process = self.parent_process
  if parent_process then
    parent_process.subtree_pcpu = parent_process.subtree_pcpu + self.subtree_pcpu
    parent_process.subtree_pmem = parent_process.subtree_pmem + self.subtree_pmem
    parent_process.subtree_rss = parent_process.subtree_rss + self.subtree_rss
  end
end

---@param depth integer
function class:print(depth)
  if not threshold(self) then
    return
  end

  local text = ("%scpu:%.1f%% mem:%.1f%% rss:%.0fMB %s[%d] %s"):format(
    ("    "):rep(depth),
    self.subtree_pcpu,
    self.subtree_pmem,
    self.subtree_rss / 1024,
    self.user,
    self.pid,
    self.command)
  io.write(text:sub(1, cols), "\n")

  depth = depth + 1
  for _, child_process in ipairs(self.child_processes) do
    child_process:print(depth)
  end
end

local help = ([[
Usage: %s [options]
Avairable options are:
  -c      --sort-pcpu
  -m      --sort-pmem
  -r      --sort-rss
  -a      --asc
  -d      --desc
  -C ARG  --threshold-pcpu=ARG
  -M ARG  --threshold-pmem=ARG
  -R ARG  --threshold-rss=ARG
  -h      --help
]]):format(arg[0])

---@type string
local sort_key = "subtree_rss"

---@type "asc"|"desc"
local sort_order = "desc"

---@type string
local threshold_key = "subtree_pmem"

---@type number
local threshold_value = 0.1

local i = 1
while i <= #arg do
  local opt = arg[i]
  i = i + 1
  if opt == "-c" or opt == "--sort-pcpu" then
    sort_key = "subtree_pcpu"
  elseif opt == "-m" or opt == "--sort-pmem" then
    sort_key = "subtree_pmem"
  elseif opt == "-r" or opt == "--sort-rss" then
    sort_key = "subtree_rss"
  elseif opt == "-a" or opt == "--asc" then
    sort_order = "asc"
  elseif opt == "-d" or opt == "--desc" then
    sort_order = "desc"
  elseif opt == "-C" or opt == "--threshold-pcpu" then
    threshold_key = "subtree_pcpu"
    threshold_value = assert(tonumber(arg[i]))
    i = i + 1
  elseif opt == "-M" or opt == "--threshold-pmem" then
    threshold_key = "subtree_pmem"
    threshold_value = assert(tonumber(arg[i]))
    i = i + 1
  elseif opt == "-R" or opt == "--threshold-rss" then
    threshold_key = "subtree_rss"
    threshold_value = assert(tonumber(arg[i]))
    i = i + 1
  elseif opt == "-h" or opt == "--help" then
    io.stderr:write(help)
    os.exit()
  elseif opt == "--" then
    break
  else
    local key, value = opt:match "^%-%-threshold%-(%w+)=(.*)"
    if not key then
      i = i - 1
      break
    end
    assert(key == "pcpu" or key == "pmem" or key == "rss")
    threshold_key = "subtree_" .. key
    threshold_value = assert(tonumber(value))
  end
end

---@param a dromozoa.dotfiles.pst.process
---@param b dromozoa.dotfiles.pst.process
---@return boolean
function sort(a, b)
  if sort_order == "desc" then
    return a[sort_key] > b[sort_key]
  else
    return a[sort_key] < b[sort_key]
  end
end

---@param process dromozoa.dotfiles.pst.process
---@return boolean
function threshold(process)
  return process[threshold_key] >= threshold_value
end

---@type table<integer, dromozoa.dotfiles.pst.process>
local process_map = {}

local handle = assert(io.popen(("ps -a -x -o '%s'"):format(table.concat(keywords, ","))))
local first = true
for line in handle:lines() do
  if first then
    first = false
  else
    ---@type string
    local line = line

    ---@type string[]
    local items = {}
    local p = 1
    for _ = 1, #keywords - 1 do
      ---@type integer, integer, string
      local _, j, item = assert(line:find("^(%S+)%s+", p))
      table.insert(items, item)
      p = j + 1
    end
    table.insert(items, line:sub(p))

    local process = class.new(items)
    process_map[process.pid] = process
  end
end
handle:close()

---@type dromozoa.dotfiles.pst.process[]
local root_processes = {}

for _, process in pairs(process_map) do
  ---@type dromozoa.dotfiles.pst.process?
  local parent_process = process_map[process.ppid]
  if parent_process then
    process.parent_process = parent_process
    table.insert(parent_process.child_processes, process)
  else
    table.insert(root_processes, process)
  end
end

for _, root_process in ipairs(root_processes) do
  root_process:compute_subtree()
end
for _, root_process in ipairs(root_processes) do
  root_process:print(0)
end

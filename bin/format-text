local home = os.getenv "HOME"
package.path = home .. "/dromozoa-dotfiles/?.lua;"
    .. home .. "/dromozoa-dotfiles/modules/dromozoa-calendar/?.lua;"
    .. home .. "/dromozoa-dotfiles/modules/dromozoa-commons/?.lua;"
    .. home .. "/dromozoa-dotfiles/modules/dromozoa-utf8/?.lua;"
    .. package.path

local format_text = require "dromozoa.format_text"

local help = string.format([[
Usage: %s [options]
Avairable options are:
  -w INTEGER  --text-width=INTEGER
  -h          --help
]], arg[0])

local text_width = 0

local i = 1
while i <= #arg do
  local opt = arg[i]
  i = i + 1
  if opt == "-w" or opt == "--text-width" then
    text_width = assert(tonumber(arg[i]))
    i = i + 1
  elseif opt == "-h" or opt == "--help" then
    io.stderr:write(help)
    os.exit()
  elseif opt == "--" then
    break
  else
    local value = opt:match "^%-%-text%-width=(.*)"
    if not value then
      i = i - 1
      break
    end
    text_width = assert(tonumber(arg[i]))
  end
end

local source = {}
for line in io.lines() do
  table.insert(source, line)
end
io.write(format_text(source, text_width))

local help = [[
Usage: iterm2-file profile
Available profiles are:
]]

local profiles = {
  "moyu-2026",
  "moyu-2026-ambiwidth-half",
}

local profile_set = {}
for _, profile in ipairs(profiles) do
  profile_set[profile] = true
end

local profile = ...
if not profile_set[profile] then
  io.stderr:write(help)
  for _, profile in ipairs(profiles) do
    io.stderr:write("  ", profile, "\n")
  end
  os.exit()
end

io.write("\27]1337;SetProfile=", profile, "\27\\")

path_save=$PATH

PATH=\
$HOME/dromozoa-dotfiles/bin:\
$HOME/prefixes/dromozoa55/bin:\
$HOME/prefixes/dromozoa/bin:\
/opt/dromozoa55/bin:\
/opt/dromozoa/bin:\
/usr/local/bin:\
/usr/bin:\
/bin:\
/usr/sbin:\
/sbin

MANPATH=\
$HOME/prefixes/dromozoa55/share/man:\
$HOME/prefixes/dromozoa/share/man:\
/opt/dromozoa55/share/man:\
/opt/dromozoa/share/man:\
/usr/local/share/man:\
/usr/share/man

# Git BASHでは元のPATHを継承する
case X$MSYSTEM in
  X) ;;
  *) PATH=$PATH:$path_save;;
esac

LANG=$(locale -a 2>&1 | sed -n '/^ja_JP\.[Uu][Tt][Ff]-*8$/p')
case X$LANG in
  X) LANG=$(locale -a 2>&1 | sed -n '/^C\.[Uu][Tt][Ff]-*8$/p');;
esac
case X$LANG in
  X) LANG=C;;
esac

INSIDE_GNU_SCREEN=
case X$STY in
  X)
    case X$TERM in
      Xscreen*) INSIDE_GNU_SCREEN=1;;
    esac
    ;;
  *) INSIDE_GNU_SCREEN=1;;
esac

if infocmp "$TERM" >/dev/null 2>&1
then
  :
elif test "$TERM" = screen.xterm-256color
then
  for i in screen-256color screen
  do
    if infocmp "$i" >/dev/null 2>&1
    then
      TERM=$i
      break
    fi
  done
fi

EDITOR=vim

CPPFLAGS="-I$HOME/prefixes/dromozoa/include -I/opt/dromozoa/include"
LDFLAGS="-L$HOME/prefixes/dromozoa/lib -L/opt/dromozoa/lib"
case X$(uname) in
  XDarwin) ;;
  *) LDFLAGS="$LDFLAGS -Wl,-rpath -Wl,$HOME/prefixes/dromozoa/lib $LDFLAGS -Wl,-rpath -Wl,/opt/dromozoa/lib";;
esac

export PATH MANPATH LANG INSIDE_GNU_SCREEN TERM EDITOR CPPFLAGS LDFLAGS
